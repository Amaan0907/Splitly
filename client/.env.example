# Production API origin (no trailing slash). .env.production already sets it to
# https://splitly-0qy4.onrender.com for `npm run build`.
# Leave empty in development: Vite proxies /api for you.
VITE_API_URL=

# Dev only: where the Vite proxy sends /api. Defaults to the deployed API.
# Use http://localhost:4000 to work against a local server.
API_PROXY_TARGET=
